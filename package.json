{
  "name": "coding-buddy",
  "displayName": "Coding Buddy",
  "description": "A patient coding companion: clues first, answers when you need them.",
  "version": "0.0.14",
  "publisher": "aatish1321",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/aatish1321/coding-buddy.git" },
  "engines": { "vscode": "^1.93.0" },
  "categories": ["Education", "Other"],
  "keywords": ["learning", "hints", "beginner", "coding", "ai"],
  "main": "./out/src/extension.js",
  "extensionKind": ["ui"],
  "capabilities": { "untrustedWorkspaces": { "supported": "limited", "description": "The buddy panel and settings are available in Restricted Mode. Terminal watching and AI analysis require trusting the folder." }, "virtualWorkspaces": false },
  "activationEvents": ["onStartupFinished", "onView:codingBuddy.panel"],
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "codingBuddy", "title": "Coding Buddy", "icon": "media/buddy-icon.svg" }] },
    "views": { "codingBuddy": [{ "type": "webview", "id": "codingBuddy.panel", "name": "Coding Buddy" }] },
    "menus": { "editor/title": [{ "command": "codingBuddy.runFile", "when": "isWorkspaceTrusted && (resourceExtname == .py || resourceExtname == .js || resourceExtname == .mjs || resourceExtname == .cjs)", "group": "navigation@1" }] },
    "commands": [
      { "command": "codingBuddy.projectMode", "title": "Coding Buddy: Project Mode" },
      { "command": "codingBuddy.runFile", "title": "Coding Buddy: Run with Buddy", "icon": "$(play-circle)" },
      { "command": "codingBuddy.openPlayground", "title": "Coding Buddy: Open Playground" },
      { "command": "codingBuddy.connect", "title": "Coding Buddy: Connect Terminal" },
      { "command": "codingBuddy.disconnect", "title": "Coding Buddy: Disconnect" },
      { "command": "codingBuddy.setKey", "title": "Coding Buddy: Set API Key" },
      { "command": "codingBuddy.removeKey", "title": "Coding Buddy: Remove API Key" },
      { "command": "codingBuddy.chooseProvider", "title": "Coding Buddy: Choose AI Provider" },
      { "command": "codingBuddy.settings", "title": "Coding Buddy: Settings" },
      { "command": "codingBuddy.reset", "title": "Coding Buddy: Reset Current Issue" },
      { "command": "codingBuddy.retry", "title": "Coding Buddy: Retry Analysis" },
      { "command": "codingBuddy.acceptFix", "title": "Coding Buddy: Accept Reviewed Fix" },
      { "command": "codingBuddy.rejectFix", "title": "Coding Buddy: Reject Reviewed Fix" },
      { "command": "codingBuddy.toggleConfetti", "title": "Coding Buddy: Toggle Confetti" }
    ],
    "configuration": {
      "title": "Coding Buddy",
      "properties": {
        "codingBuddy.autoWatch": { "type": "boolean", "default": true, "scope": "application", "description": "Automatically check completed terminal runs using files identified in the opened folder and relevant project context. Code and output are sent to your selected AI provider. Pause this in the buddy settings menu." },
        "codingBuddy.provider": { "type": "string", "enum": ["gemini", "openai", "groq"], "default": "gemini", "scope": "application", "description": "AI provider that receives your connected code and run output. Use Coding Buddy: Set API Key to store its key securely." },
        "codingBuddy.models.gemini": { "type": "string", "default": "gemini-3.5-flash-lite", "scope": "application", "description": "Gemini model with structured-output support. Model availability depends on your account." },
        "codingBuddy.models.openai": { "type": "string", "default": "gpt-6-luna", "scope": "application", "description": "OpenAI model with Responses API structured-output support." },
        "codingBuddy.models.groq": { "type": "string", "default": "openai/gpt-oss-120b", "scope": "application", "description": "Groq-hosted model with strict structured-output support." },
        "codingBuddy.animateCharacter": { "type": "boolean", "default": true, "scope": "application", "description": "Animate the buddy character while idle, thinking and celebrating. Reduced-motion preferences are always respected." },
        "codingBuddy.confetti": { "type": "boolean", "default": true, "scope": "application", "description": "Celebrate a solved issue with confetti. Reduced-motion preferences are always respected." }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:host": "npm run compile && node scripts/test-host.cjs",
    "test:trust": "npm run compile && node scripts/test-host.cjs --restricted",
    "test:package": "node scripts/test-host.cjs --package",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --skip-license --out coding-buddy-0.0.14.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.93.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
